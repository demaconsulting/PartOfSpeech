<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.PartOfSpeech</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>Pure .NET part-of-speech (Universal POS) tagger from DEMA Consulting: tokenizer, sentence splitter and averaged-perceptron tagger with lexicon-restricted decoding, calibrated confidences and per-token constraints; no native or model-runtime dependencies.</Description>
    <!-- The package embeds data under three licenses (the MIT code, the CC BY 4.0 lexicon and the weights that are
         trained on CC BY 3.0 US data). nuget.org accepts only license expressions that the OSI or FSF approve, and
         CC-BY-3.0-US is neither, so the license is a file (a package carries an expression or a file, never both).
         PACKAGE-LICENSE.md opens with the SPDX expression for scanners. The repository LICENSE stays plain MIT. -->
    <PackageLicenseFile>PACKAGE-LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/demaconsulting/PartOfSpeech</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/PartOfSpeech</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>part-of-speech;nlp;dotnet-library</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>Part Of Speech</Title>
    <Product>PartOfSpeech</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- API Documentation Configuration -->
    <!-- ApiMark turns this project's XML doc comments into gradually-disclosed Markdown API
         reference (index -> namespace -> type -> member) for a coding agent to read.
         - Output goes under 'generated/', which the repository already excludes from git,
           markdownlint, and TextLint, so the build regenerates it and nothing stale is committed.
         - ApiMarkPackDocs ships the generated api/ tree inside the nupkg, so a consuming agent
           receives the reference with the library.
         - ApiMarkEnforceDocs fails the build on any public API member lacking an XML doc
           summary; the Public tier matches the surface that is generated and shipped. -->
    <ApiMarkOutputDir>$(MSBuildProjectDirectory)\generated\api</ApiMarkOutputDir>
    <ApiMarkVisibility>Public</ApiMarkVisibility>
    <ApiMarkPackDocs>true</ApiMarkPackDocs>
    <ApiMarkEnforceDocs>Public</ApiMarkEnforceDocs>
    <ApiMarkEnforceDocsSeverity>Error</ApiMarkEnforceDocsSeverity>
    <ApiMarkLibraryDescription>Part-of-speech tagging for .NET: a tokenizer, a sentence splitter and an averaged-perceptron Universal POS tagger with lexicon-restricted decoding, calibrated confidences and per-token constraints.</ApiMarkLibraryDescription>

    <!-- Polyfill Configuration -->
    <PolyArgumentExceptions>true</PolyArgumentExceptions>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <PackageReference Include="Polyfill" Version="11.4.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
    <!-- Build-time only: PrivateAssets="All" keeps the documentation generator out of any
         package that consumes this library. -->
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.5.12" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this library.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Internals are shared with the tests, the lexicon compiler tool and the trainer tool. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.PartOfSpeech.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.PartOfSpeech.LexiconCompiler" />
    <InternalsVisibleTo Include="DemaConsulting.PartOfSpeech.Trainer" />
  </ItemGroup>

  <!-- The compiled lexicon (generated by tools/LexiconCompiler from data/lexicon/lexicon.tsv) and the trained weights
       (generated by tools/DemaConsulting.PartOfSpeech.Trainer from the committed corpora and training.json). The
       explicit logical names keep the resource names independent of the root namespace. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\lexicon.bin" LogicalName="DemaConsulting.PartOfSpeech.Resources.lexicon.bin" />
    <EmbeddedResource Include="Resources\weights.bin" LogicalName="DemaConsulting.PartOfSpeech.Resources.weights.bin" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\PACKAGE-LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
